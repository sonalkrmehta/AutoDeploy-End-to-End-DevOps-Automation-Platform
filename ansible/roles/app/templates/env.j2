# Managed by Ansible - changes made here are overwritten on the next deployment.
APP_IMAGE={{ app_image }}
APP_VERSION={{ app_version }}
APP_ENV={{ app_env }}
ENABLE_SIMULATE={{ app_enable_simulate | bool | lower }}
NGINX_PORT={{ app_nginx_port }}
PUBLIC_URL={{ app_public_url }}
PROMETHEUS_RETENTION={{ app_prometheus_retention }}
GRAFANA_ADMIN_USER={{ app_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD='{{ app_grafana_admin_password }}'
