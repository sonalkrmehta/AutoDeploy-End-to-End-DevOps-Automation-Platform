# Local development settings. Copy to `.env` (cp .env.example .env).
# On AWS this file is generated by Ansible - you never create it on the server.

# Port Nginx listens on. 8080 avoids clashes with other local web servers.
NGINX_PORT=8080

# Public URL of the stack as seen by your browser (used by Grafana for redirects).
PUBLIC_URL=http://localhost:8080

APP_ENV=local
APP_VERSION=local
ENABLE_SIMULATE=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

PROMETHEUS_RETENTION=7d
